# Local SQLite file. Optional: when omitted the app uses ./.data/taskflow.db.
# DATABASE_URL=file:./.data/taskflow.db

# Remote libSQL/Turso database (used in production on Vercel).
# DATABASE_URL=libsql://<database>-<account>.turso.io
# DATABASE_AUTH_TOKEN=<token>

# Secret used to sign session cookies. Required in production, at least 32 characters.
# AUTH_SECRET=<long-random-string>

# Optional. The browser uses same-origin /api by default.
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# AI Task Generator (OpenAI-compatible API, server-side only).
# Without AI_API_KEY the generator runs in clearly marked demo mode.
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4.1-mini
# AI_MOCK=1

# Optional trusted browser origins when HTTPS is terminated by a reverse proxy.
# Comma-separated exact origins, no wildcard.
# APP_ORIGINS=https://taskflow.example.com

# Persistent uploads directory. Share the same volume across production instances.
# FILE_STORAGE_PATH=./.data/uploads

# Remote migration only: set after taking a verified provider snapshot.
# CONFIRM_REMOTE_MIGRATION=1

# Fallback reminder thresholds only when no per-user settings exist (hours, comma-separated).
# TASK_REMINDER_HOURS=24
