# Local SQLite file. Optional: when omitted the app uses ./.data/taskflow.db.
# DATABASE_URL=file:./.data/taskflow.db

# Remote libSQL/Turso database (used in production on Vercel).
# DATABASE_URL=libsql://<database>-<account>.turso.io
# DATABASE_AUTH_TOKEN=<token>

# Secret used to sign session cookies. Required in production.
# AUTH_SECRET=<long-random-string>

# Optional. The browser uses same-origin /api by default.
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
